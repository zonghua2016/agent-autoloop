{
  "ci": { "pipeline": "0", "env": {} },
  "checks": [{ "name": "autoloop-ci", "writers": ["REPLACE_SERVICE_USER_ID"] }],
  "sensitive": ["src/auth/**", "src/payment/**", "prisma/**", "scripts/**", "Dockerfile"],
  "review": {
    "model": "gpt-6-astra",
